    <whitePkg name="com.example.keep" category="001"/>
    <whitePkg name="com.google.android.gms" category="001"/>
    <prevent scene="110" pkg="com.google.android.gms" mask="1111111110"/>
    <prevent scene="110" pkg="com.google.android.gsf" mask="1111111110"/>
